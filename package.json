{
	"name": "@trenlok/vscode-toolbox",
	"type": "module",
	"version": "1.6.3",
	"private": true,
	"description": "A lightweight project manager for Visual Studio Code",
	"author": "TrenLok",
	"license": "MIT",
	"engines": {
		"node": ">=24.21.0"
	},
	"scripts": {
		"dev": "nuxt dev --public",
		"generate": "nuxt generate",
		"preinstall": "npx only-allow pnpm",
		"postinstall": "nuxt prepare",
		"prepare": "pnpm run hooks:install",
		"bump": "bumpp",
		"typecheck": "nuxt typecheck",
		"tauri": "tauri",
		"tauri:dev": "node scripts/tauri-test.mjs dev",
		"tauri:build": "tauri build",
		"tauri:build:test": "node scripts/tauri-test.mjs",
		"tauri:build:debug": "tauri build --debug",
		"fmt:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
		"fmt:js": "eslint . --cache --fix",
		"fmt:styles": "stylelint \"**/*.{scss,vue}\" --cache --allow-empty-input --fix",
		"lint:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
		"lint:js": "eslint . --cache",
		"lint:styles": "stylelint \"**/*.{scss,vue}\" --cache --allow-empty-input",
		"lint": "pnpm run lint:rs && pnpm run lint:js && pnpm run lint:styles",
		"format": "pnpm run fmt:rs && pnpm run fmt:js && pnpm run fmt:styles",
		"analyze:rs": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
		"hooks:install": "pnpm exec simple-git-hooks"
	},
	"dependencies": {
		"@pinia/nuxt": "^1.0.2",
		"@rhapsodic/bem-classnames": "^2.1.0",
		"@tauri-apps/api": "^2.12.0",
		"@tauri-apps/plugin-autostart": "~2.6.0",
		"@tauri-apps/plugin-dialog": "~2.8.0",
		"@tauri-apps/plugin-fs": "^2.6.0",
		"@tauri-apps/plugin-log": "~2.10.0",
		"@tauri-apps/plugin-notification": "^2.5.0",
		"@tauri-apps/plugin-opener": "~2.6.0",
		"@tauri-apps/plugin-os": "^2.4.0",
		"@tauri-apps/plugin-process": "~2.4.0",
		"@tauri-apps/plugin-shell": "^2.4.0",
		"@tauri-apps/plugin-store": "^2.5.0",
		"@tauri-apps/plugin-updater": "~2.13.0",
		"nuxt": "4.6.1",
		"perfect-scrollbar": "^1.5.6",
		"pinia": "^4.0.3",
		"vue": "^3.5.43",
		"vue-final-modal": "^4.5.5",
		"vue-router": "^5.3.1"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@rhapsodic/eslint-config": "^5.0.0",
		"@rhapsodic/stylelint-config": "^2.0.0",
		"@tauri-apps/cli": "^2.12.0",
		"@vueuse/core": "^15.0.0",
		"@vueuse/nuxt": "^15.0.0",
		"bumpp": "^12.3.0",
		"eslint": "^10.11.0",
		"eslint-plugin-vuejs-accessibility": "^2.6.0",
		"nuxt3-notifications": "^1.4.0",
		"postcss-html": "^2.0.0",
		"postcss-media-minmax": "^5.0.0",
		"postcss-scss": "^4.0.9",
		"sass-embedded": "^1.105.0",
		"simple-git-hooks": "^2.14.0",
		"stylelint": "^17.15.0",
		"typescript": "^6.0.3",
		"vue-tsc": "^3.3.11"
	},
	"simple-git-hooks": {
		"commit-msg": "pnpm exec commitlint --edit",
		"pre-commit": "pnpm run lint"
	},
	"packageManager": "pnpm@12.7.0"
}
